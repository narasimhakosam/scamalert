# Student ScamGuard AI — Backend Environment Configuration (.env.example)

# Server & Network
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
CORS_ORIGINS=*

# Security Limits
MAX_MESSAGE_LENGTH=5000
RATE_LIMIT_PER_MINUTE=60

# Model & Metadata Versions
MODEL_VERSION=spamclf-v1
DATASET_VERSION=sms-spam-collection-v1
RULESET_VERSION=rules-v1

# Scoring Weights
ML_BASE_MAX=55
URL_RISK_BASE=5

# Classification Thresholds (0-100)
SAFE_MAX=29
SUSPICIOUS_MAX=59
